#include <iostream>
#include <fstream>
#include <sys/utsname.h>
#include <cstring>

int main() {
    struct utsname sysInfo;

    // Get system and kernel information
    if (uname(&sysInfo) == -1) {
        perror("uname");
        return 1;
    }

    std::cout << "Kernel Name: " << sysInfo.sysname << std::endl;
    std::cout << "Kernel Version: " << sysInfo.release << std::endl;
    std::cout << "Kernel Release: " << sysInfo.version << std::endl;
    std::cout << "Machine (CPU Type): " << sysInfo.machine << std::endl;
    std::cout << "Node Name (Hostname): " << sysInfo.nodename << std::endl;

    // Open /proc/cpuinfo to get detailed CPU info
    std::ifstream cpuinfo("/proc/cpuinfo");
    if (!cpuinfo) {
        std::cerr << "Failed to open /proc/cpuinfo" << std::endl;
        return 1;
    }

    std::string line;
    std::cout << "\nCPU Information:\n";
    while (std::getline(cpuinfo, line)) {
        if (line.find("model name") == 0 || 
            line.find("cpu MHz") == 0 || 
            line.find("cache size") == 0) {
            std::cout << line << std::endl;
        }
    }

    cpuinfo.close();
    return 0;
}
