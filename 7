#include <iostream>
#include <fcntl.h>
#include <unistd.h>
#include <cstring>
#include <cerrno>

#define BUFFER_SIZE 4096

int main(int argc, char *argv[]) {
    if (argc != 3) {
        std::cerr << "Usage: " << argv[0] << " <source_file> <destination_file>\n";
        return 1;
    }

    int srcFd = open(argv[1], O_RDONLY);
    if (srcFd < 0) {
        std::cerr << "Error opening source file: " << strerror(errno) << "\n";
        return 1;
    }

    int destFd = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (destFd < 0) {
        std::cerr << "Error opening destination file: " << strerror(errno) << "\n";
        close(srcFd);
        return 1;
    }

    char buffer[BUFFER_SIZE];
    ssize_t bytesRead;

    while ((bytesRead = read(srcFd, buffer, BUFFER_SIZE)) > 0) {
        ssize_t bytesWritten = 0;
        while (bytesWritten < bytesRead) {
            ssize_t result = write(destFd, buffer + bytesWritten, bytesRead - bytesWritten);
            if (result < 0) {
                std::cerr << "Error writing to destination file: " << strerror(errno) << "\n";
                close(srcFd);
                close(destFd);
                return 1;
            }
            bytesWritten += result;
        }
    }

    if (bytesRead < 0) {
        std::cerr << "Error reading source file: " << strerror(errno) << "\n";
    }

    close(srcFd);
    close(destFd);
    std::cout << "File copied successfully.\n";
    return 0;
}
